{
  "name": "urna-eletronica",
  "version": "1.0.0",
  "description": "Réplica da urna eletrônica brasileira para eventos e festas",
  "main": "main.js",
  "author": "Otávio Augusto",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --x64",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "br.gov.urna.eletronica",
    "productName": "Urna Eletrônica",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "../index.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "runAfterFinish": true
    }
  }
}
